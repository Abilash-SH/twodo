# Twodo client configuration. Every value here ends up in the browser bundle, so only PUBLIC identifiers belong here.
# Firebase web API key + database URL identify your project; access is enforced by firebase.rules.json and sign-in.
# Never put secrets here (VAPID private key, service account): those live only in GitHub → Settings → Secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# For push reminders (README → "Push reminders"): the PUBLIC VAPID key only
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Local testing against an emulator/mock (leave empty in production)
NEXT_PUBLIC_AUTH_EMULATOR=
# "/twodo" when hosted at https://<user>.github.io/twodo/
NEXT_PUBLIC_BASE_PATH=
